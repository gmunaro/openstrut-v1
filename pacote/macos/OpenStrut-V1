#!/bin/bash
# Executável do "OpenStrut V1.app". Os programas da V1 são executáveis soltos
# (não são apps), e o macOS barra os que vieram de um download enquanto têm o
# atributo de quarentena. Por isso, na primeira execução e a cada versão nova,
# este script copia Contents/Resources/V1 para
# ~/Library/Application Support/OpenStrut/V1, tira a quarentena da cópia e roda o
# lançador OPENSTRUT.exe de lá. As obras ficam em ~/OpenStrut (a pasta C: do
# lançador), fora do app e dessa cópia.
set -u

RECURSOS="$(cd "$(dirname "$0")/../Resources" && pwd)"
DESTINO="$HOME/Library/Application Support/OpenStrut/V1"

avisar() {
    osascript -e 'on run argv' -e 'display alert "OpenStrut V1" message (item 1 of argv)' \
        -e 'end run' "$1" > /dev/null 2>&1 || echo "$1" >&2
}

versao="$(cat "$RECURSOS/VERSAO")"
if [ "$(cat "$DESTINO/.versao" 2> /dev/null)" != "$versao" ] || [ ! -x "$DESTINO/OPENSTRUT.exe" ]; then
    # apagar antes de copiar: sobrescrever um executável assinado no mesmo lugar
    # faz o macOS matá-lo na próxima execução
    rm -rf "$DESTINO"
    if ! mkdir -p "$DESTINO" || ! cp -R "$RECURSOS/V1/." "$DESTINO/"; then
        avisar "Não foi possível copiar os programas para $DESTINO."
        exit 1
    fi
    xattr -dr com.apple.quarantine "$DESTINO" 2> /dev/null || true
    echo "$versao" > "$DESTINO/.versao"
fi

# Os programas são x64. O executável do app é este script, então o macOS não oferece
# instalar o Rosetta 2 sozinho nos Macs com Apple Silicon: sem ele o exec falharia mudo.
if ! arch -x86_64 /usr/bin/true 2> /dev/null; then
    avisar "O OpenStrut V1 é um programa para Intel (x64) e precisa do Rosetta 2. Instale-o no Terminal com: softwareupdate --install-rosetta --agree-to-license"
    exit 1
fi

cd "$DESTINO" || exit 1
# com execfail, um exec que falha volta para o script em vez de encerrá-lo
shopt -s execfail
exec "$DESTINO/OPENSTRUT.exe"
avisar "Não foi possível abrir $DESTINO/OPENSTRUT.exe."
exit 1
