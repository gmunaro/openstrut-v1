SUB RT_COMMON_LE (f AS INTEGER)
    DIM ender AS LONG, tipo AS STRING * 1, nd AS INTEGER, lb(1 TO 3) AS LONG, ub(1 TO 3) AS LONG
    DIM tam AS LONG, prox AS LONG
    DO WHILE RT_CL_ITEM(f, ender, tipo, nd, lb(), ub(), tam)
        prox = SEEK(f) + tam
        SELECT CASE ender
        CASE &H0000   ' V_0dc0
            IF tipo = "$" THEN
                V_0dc0$ = RT_CL_STR$(f)
            END IF
        CASE &H0004   ' V_0dc4
            IF tipo = "$" THEN
                V_0dc4$ = RT_CL_STR$(f)
            END IF
        CASE &H0008   ' V_0dc8
            IF tipo = "$" THEN
                V_0dc8$ = RT_CL_STR$(f)
            END IF
        CASE &H000C   ' V_0dcc
            IF tipo = "$" THEN
                V_0dcc$ = RT_CL_STR$(f)
            END IF
        CASE &H0010   ' V_0dd0
            IF tipo = "$" THEN
                V_0dd0$ = RT_CL_STR$(f)
            END IF
        CASE &H0014   ' V_0dd4
            IF tipo = "$" THEN
                V_0dd4$ = RT_CL_STR$(f)
            END IF
        CASE &H0018   ' V_0dd8
            IF tipo = "$" THEN
                V_0dd8$ = RT_CL_STR$(f)
            END IF
        CASE &H001C   ' V_0ddc
            IF tipo = "!" THEN
                GET #f, , V_0ddc!
            END IF
        CASE &H0020   ' V_0de0
            IF tipo = "!" THEN
                GET #f, , V_0de0!
            END IF
        CASE &H0024   ' V_0de4
            IF tipo = "!" THEN
                GET #f, , V_0de4!
            END IF
        CASE &H0028   ' V_0de8
            IF tipo = "!" THEN
                GET #f, , V_0de8!
            END IF
        CASE &H002C   ' V_0dec
            IF tipo = "!" THEN
                GET #f, , V_0dec!
            END IF
        CASE &H0030   ' V_0df0
            IF tipo = "!" THEN
                GET #f, , V_0df0!
            END IF
        CASE &H0034   ' V_0df4
            IF tipo = "!" THEN
                GET #f, , V_0df4!
            END IF
        CASE &H0038   ' V_0df8
            IF tipo = "!" THEN
                GET #f, , V_0df8!
            END IF
        CASE &H003C   ' V_0dfc
            IF tipo = "$" THEN
                V_0dfc$ = RT_CL_STR$(f)
            END IF
        CASE &H0040   ' V_0e00
            IF tipo = "$" THEN
                V_0e00$ = RT_CL_STR$(f)
            END IF
        CASE &H0044   ' V_0e04
            IF tipo = "$" THEN
                V_0e04$ = RT_CL_STR$(f)
            END IF
        CASE &H0048   ' V_0e08
            IF tipo = "$" THEN
                V_0e08$ = RT_CL_STR$(f)
            END IF
        CASE &H004C   ' V_0e0c
            IF tipo = "$" THEN
                V_0e0c$ = RT_CL_STR$(f)
            END IF
        CASE &H0050   ' V_0e10
            IF tipo = "$" THEN
                V_0e10$ = RT_CL_STR$(f)
            END IF
        CASE &H0054   ' V_0e14
            IF tipo = "!" THEN
                GET #f, , V_0e14!
            END IF
        CASE &H0058   ' V_0e18
            IF tipo = "!" THEN
                GET #f, , V_0e18!
            END IF
        CASE &H005C   ' V_0e1c
            IF tipo = "!" THEN
                GET #f, , V_0e1c!
            END IF
        CASE &H0060   ' V_0e20
            IF tipo = "!" THEN
                GET #f, , V_0e20!
            END IF
        CASE &H0064   ' V_0e24
            IF tipo = "!" THEN
                GET #f, , V_0e24!
            END IF
