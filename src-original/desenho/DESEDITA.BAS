' ON KEY dentro de SUB: -1 = o tratador i volta com RETURN simples e roda aqui; 0 = sai da SUB.
FUNCTION RT_ONKEY_FICA% (i AS INTEGER)
    SELECT CASE i
        CASE 1   ' L_13434: BEEP; GOSUB L_1315c; RETURN
            BEEP
            RT_ONKEY_FICA% = -1
        CASE 2   ' L_1345f: sai da SUB (RT_VIEWPRINT 1, 25; COLOR 7, 0, 0; RT_CLS 0; PRINT " Aguarde ..."; PRINT ""; PRI)
        CASE 3   ' L_13564: sai da SUB (BEEP; GOSUB L_1315c; RETURN L_101e6)
    END SELECT
END FUNCTION

SUB RT_REARMA_ERRO
    RT_ERRO_MIXT = 0
    SELECT CASE RT_ONERR
        CASE &H1092f: ON ERROR GOTO L_1092f
        CASE &H13077: ON ERROR GOTO L_13077
        CASE &H13401: ON ERROR GOTO L_13401
        CASE &H13514: ON ERROR GOTO L_13514
        CASE &H13657: ON ERROR GOTO L_13657
        CASE &H138ad: ON ERROR GOTO L_138ad
        CASE &H30134: ON ERROR GOTO L_30134
        CASE ELSE: ON ERROR GOTO RT_ERRO_FATAL
    END SELECT
END SUB

