    IF LBOUND(A_1692!, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H08D2, "!", 2, LBOUND(A_1692!, 1), UBOUND(A_1692!, 1), LBOUND(A_1692!, 2), UBOUND(A_1692!, 2), 0, 0
