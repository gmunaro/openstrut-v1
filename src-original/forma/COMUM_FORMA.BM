    RT_CG_ITEM f, &H078A, "!", 4: PUT #f, , V_154a!
    RT_CG_ITEM f, &H078E, "!", 4: PUT #f, , V_154e!
    RT_CG_ITEM f, &H0792, "!", 4: PUT #f, , V_1552!
    RT_CG_ITEM f, &H0796, "$", 4 + LEN(V_1556$): RT_CG_STR f, V_1556$
    RT_CG_ITEM f, &H079A, "$", 4 + LEN(V_155a$): RT_CG_STR f, V_155a$
    RT_CG_ITEM f, &H079E, "$", 4 + LEN(V_155e$): RT_CG_STR f, V_155e$
    RT_CG_ITEM f, &H07A2, "$", 4 + LEN(V_1562$): RT_CG_STR f, V_1562$
    RT_CG_ITEM f, &H07A6, "$", 4 + LEN(V_1566$): RT_CG_STR f, V_1566$
    RT_CG_ITEM f, &H07AA, "$", 4 + LEN(V_156a$): RT_CG_STR f, V_156a$
    RT_CG_ITEM f, &H07AE, "$", 4 + LEN(V_156e$): RT_CG_STR f, V_156e$
    RT_CG_ITEM f, &H07B2, "$", 4 + LEN(V_1572$): RT_CG_STR f, V_1572$
    RT_CG_ITEM f, &H07B6, "$", 4 + LEN(V_1576$): RT_CG_STR f, V_1576$
    RT_CG_ITEM f, &H07BA, "$", 4 + LEN(V_157a$): RT_CG_STR f, V_157a$
    IF LBOUND(A_157e%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H07BE, "%", 1, LBOUND(A_157e%, 1), UBOUND(A_157e%, 1), 0, 0, 0, 0
        FOR i1 = LBOUND(A_157e%, 1) TO UBOUND(A_157e%, 1)
            PUT #f, , A_157e%(i1)
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_15ac%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H07EC, "%", 1, LBOUND(A_15ac%, 1), UBOUND(A_15ac%, 1), 0, 0, 0, 0
        FOR i1 = LBOUND(A_15ac%, 1) TO UBOUND(A_15ac%, 1)
            PUT #f, , A_15ac%(i1)
