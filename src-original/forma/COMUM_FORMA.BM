    RT_CG_ITEM f, &H0040, "$", 4 + LEN(V_0e00$): RT_CG_STR f, V_0e00$
    RT_CG_ITEM f, &H0044, "#", 8: PUT #f, , V_0e04#
    RT_CG_ITEM f, &H004C, "$", 4 + LEN(V_0e0c$): RT_CG_STR f, V_0e0c$
    RT_CG_ITEM f, &H0050, "$", 4 + LEN(V_0e10$): RT_CG_STR f, V_0e10$
    RT_CG_ITEM f, &H0054, "$", 4 + LEN(V_0e14$): RT_CG_STR f, V_0e14$
    RT_CG_ITEM f, &H0058, "$", 4 + LEN(V_0e18$): RT_CG_STR f, V_0e18$
    RT_CG_ITEM f, &H005C, "$", 4 + LEN(V_0e1c$): RT_CG_STR f, V_0e1c$
    RT_CG_ITEM f, &H0060, "%", 2: PUT #f, , V_0e20%
    RT_CG_ITEM f, &H0062, "$", 4 + LEN(V_0e22$): RT_CG_STR f, V_0e22$
    RT_CG_ITEM f, &H0066, "$", 4 + LEN(V_0e26$): RT_CG_STR f, V_0e26$
    RT_CG_ITEM f, &H006A, "$", 4 + LEN(V_0e2a$): RT_CG_STR f, V_0e2a$
