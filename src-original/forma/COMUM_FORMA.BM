SUB RT_COMMON_LE (f AS INTEGER)
    DIM ender AS LONG, tipo AS STRING * 1, nd AS INTEGER, lb(1 TO 3) AS LONG, ub(1 TO 3) AS LONG
    DIM tam AS LONG, prox AS LONG
    DO WHILE RT_CL_ITEM(f, ender, tipo, nd, lb(), ub(), tam)
        prox = SEEK(f) + tam
        SELECT CASE ender
        CASE &H0000   ' V_0dc0
            IF tipo = "!" THEN
                GET #f, , V_0dc0!
            END IF
        CASE &H0004   ' V_0dc4
            IF tipo = "!" THEN
                GET #f, , V_0dc4!
            END IF
        CASE &H0008   ' V_0dc8
            IF tipo = "!" THEN
                GET #f, , V_0dc8!
            END IF
        CASE &H000C   ' V_0dcc
            IF tipo = "$" THEN
                V_0dcc$ = RT_CL_STR$(f)
            END IF
        CASE &H0010   ' V_0dd0
            IF tipo = "$" THEN
                V_0dd0$ = RT_CL_STR$(f)
            END IF
        CASE &H0014   ' V_0dd4
            IF tipo = "$" THEN
                V_0dd4$ = RT_CL_STR$(f)
            END IF
        CASE &H0034   ' V_0df4
            IF tipo = "$" THEN
                V_0df4$ = RT_CL_STR$(f)
            END IF
        CASE &H0038   ' V_0df8
            IF tipo = "$" THEN
                V_0df8$ = RT_CL_STR$(f)
            END IF
        CASE &H003C   ' V_0dfc
            IF tipo = "$" THEN
                V_0dfc$ = RT_CL_STR$(f)
            END IF
        CASE &H0040   ' V_0e00
            IF tipo = "$" THEN
                V_0e00$ = RT_CL_STR$(f)
            END IF
        CASE &H0044   ' V_0e04
            IF tipo = "#" THEN
                GET #f, , V_0e04#
            END IF
        CASE &H004C   ' V_0e0c
            IF tipo = "$" THEN
                V_0e0c$ = RT_CL_STR$(f)
            END IF
        CASE &H0050   ' V_0e10
            IF tipo = "$" THEN
                V_0e10$ = RT_CL_STR$(f)
            END IF
        CASE &H0054   ' V_0e14
            IF tipo = "$" THEN
                V_0e14$ = RT_CL_STR$(f)
            END IF
        CASE &H0058   ' V_0e18
            IF tipo = "$" THEN
                V_0e18$ = RT_CL_STR$(f)
            END IF
        CASE &H005C   ' V_0e1c
            IF tipo = "$" THEN
                V_0e1c$ = RT_CL_STR$(f)
            END IF
        CASE &H0060   ' V_0e20
            IF tipo = "%" THEN
                GET #f, , V_0e20%
            END IF
        CASE &H0062   ' V_0e22
            IF tipo = "$" THEN
                V_0e22$ = RT_CL_STR$(f)
            END IF
        CASE &H0066   ' V_0e26
            IF tipo = "$" THEN
                V_0e26$ = RT_CL_STR$(f)
            END IF
        CASE &H006A   ' V_0e2a
            IF tipo = "$" THEN
                V_0e2a$ = RT_CL_STR$(f)
            END IF
        CASE &H006E   ' V_0e2e
            IF tipo = "$" THEN
                V_0e2e$ = RT_CL_STR$(f)
            END IF
        CASE &H0072   ' V_0e32
            IF tipo = "$" THEN
                V_0e32$ = RT_CL_STR$(f)
            END IF
        CASE &H0076   ' V_0e36
            IF tipo = "$" THEN
                V_0e36$ = RT_CL_STR$(f)
            END IF
        CASE &H007A   ' V_0e3a
            IF tipo = "$" THEN
                V_0e3a$ = RT_CL_STR$(f)
            END IF
        CASE &H007E   ' V_0e3e
            IF tipo = "$" THEN
                V_0e3e$ = RT_CL_STR$(f)
            END IF
        CASE &H0082   ' V_0e42
            IF tipo = "$" THEN
                V_0e42$ = RT_CL_STR$(f)
            END IF
        CASE &H0086   ' V_0e46
            IF tipo = "$" THEN
                V_0e46$ = RT_CL_STR$(f)
            END IF
        CASE &H008A   ' V_0e4a
            IF tipo = "$" THEN
                V_0e4a$ = RT_CL_STR$(f)
            END IF
        CASE &H008E   ' V_0e4e
            IF tipo = "$" THEN
                V_0e4e$ = RT_CL_STR$(f)
            END IF
        CASE &H0092   ' V_0e52
            IF tipo = "$" THEN
                V_0e52$ = RT_CL_STR$(f)
            END IF
        CASE &H0096   ' V_0e56
            IF tipo = "%" THEN
                GET #f, , V_0e56%
            END IF
        CASE &H0098   ' V_0e58
            IF tipo = "%" THEN
                GET #f, , V_0e58%
            END IF
        CASE &H009A   ' V_0e5a
            IF tipo = "%" THEN
                GET #f, , V_0e5a%
            END IF
        CASE &H009C   ' V_0e5c
            IF tipo = "%" THEN
                GET #f, , V_0e5c%
            END IF
        CASE &H009E   ' V_0e5e
            IF tipo = "%" THEN
                GET #f, , V_0e5e%
            END IF
        CASE &H00A0   ' V_0e60
            IF tipo = "%" THEN
                GET #f, , V_0e60%
            END IF
        CASE &H00A2   ' V_0e62
            IF tipo = "%" THEN
                GET #f, , V_0e62%
            END IF
        CASE &H00A4   ' V_0e64
            IF tipo = "%" THEN
                GET #f, , V_0e64%
            END IF
        CASE &H00A6   ' V_0e66
            IF tipo = "%" THEN
                GET #f, , V_0e66%
            END IF
        CASE &H00A8   ' V_0e68
            IF tipo = "!" THEN
                GET #f, , V_0e68!
            END IF
        CASE &H00AC   ' V_0e6c
            IF tipo = "$" THEN
                V_0e6c$ = RT_CL_STR$(f)
            END IF
        CASE &H00B0   ' V_0e70
            IF tipo = "!" THEN
                GET #f, , V_0e70!
            END IF
        CASE &H00B4   ' V_0e74
            IF tipo = "$" THEN
                V_0e74$ = RT_CL_STR$(f)
            END IF
        CASE &H00B8   ' A_0e78
            IF tipo = "!" THEN
                REDIM A_0e78!(lb(1) TO ub(1), lb(2) TO ub(2))
                FOR i2 = lb(2) TO ub(2)
                    FOR i1 = lb(1) TO ub(1)
                        GET #f, , A_0e78!(i1, i2)
                    NEXT
                NEXT
            END IF
        CASE &H00E6   ' A_0ea6
            IF tipo = "!" THEN
                REDIM A_0ea6!(lb(1) TO ub(1), lb(2) TO ub(2))
                FOR i2 = lb(2) TO ub(2)
                    FOR i1 = lb(1) TO ub(1)
                        GET #f, , A_0ea6!(i1, i2)
                    NEXT
                NEXT
            END IF
        CASE &H0114   ' A_0ed4
            IF tipo = "!" THEN
