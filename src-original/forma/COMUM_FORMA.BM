    IF LBOUND(A_171c%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H095C, "%", 3, LBOUND(A_171c%, 1), UBOUND(A_171c%, 1), LBOUND(A_171c%, 2), UBOUND(A_171c%, 2), LBOUND(A_171c%, 3), UBOUND(A_171c%, 3)
