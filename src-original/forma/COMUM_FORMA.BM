    IF LBOUND(A_17d4!, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0A14, "!", 2, LBOUND(A_17d4!, 1), UBOUND(A_17d4!, 1), LBOUND(A_17d4!, 2), UBOUND(A_17d4!, 2), 0, 0
        FOR i2 = LBOUND(A_17d4!, 2) TO UBOUND(A_17d4!, 2)
            FOR i1 = LBOUND(A_17d4!, 1) TO UBOUND(A_17d4!, 1)
                PUT #f, , A_17d4!(i1, i2)
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    RT_CG_ITEM f, &H0A42, "%", 2: PUT #f, , V_1802%
    IF LBOUND(A_1804!, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0A44, "!", 2, LBOUND(A_1804!, 1), UBOUND(A_1804!, 1), LBOUND(A_1804!, 2), UBOUND(A_1804!, 2), 0, 0
        FOR i2 = LBOUND(A_1804!, 2) TO UBOUND(A_1804!, 2)
            FOR i1 = LBOUND(A_1804!, 1) TO UBOUND(A_1804!, 1)
                PUT #f, , A_1804!(i1, i2)
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_1832%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0A72, "%", 2, LBOUND(A_1832%, 1), UBOUND(A_1832%, 1), LBOUND(A_1832%, 2), UBOUND(A_1832%, 2), 0, 0
        FOR i2 = LBOUND(A_1832%, 2) TO UBOUND(A_1832%, 2)
            FOR i1 = LBOUND(A_1832%, 1) TO UBOUND(A_1832%, 1)
                PUT #f, , A_1832%(i1, i2)
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    RT_CG_ITEM f, &H0AA0, "!", 4: PUT #f, , V_1860!
    RT_CG_ITEM f, &H0AA4, "!", 4: PUT #f, , V_1864!
END SUB

