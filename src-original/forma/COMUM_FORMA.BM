' Grava/le o COMMON da familia FORMA no arquivo de troca do CHAIN (ver comum/RT45.BM).
' Formato de cada item: deslocamento no bloco COMMON (LONG; DS:0DC0 = 0), tipo (1 byte:
' ! # % & $), n. de dimensoes (INTEGER),
' limites (LONG inferior, LONG superior por dimensao), tamanho dos dados (LONG), dados.
' Strings: LONG com o comprimento e os bytes. Matrizes nao dimensionadas nao sao gravadas.

SUB RT_COMMON_GRAVA (f AS INTEGER)
    RT_CG_ITEM f, &H0000, "!", 4: PUT #f, , V_0dc0!
    RT_CG_ITEM f, &H0004, "!", 4: PUT #f, , V_0dc4!
    RT_CG_ITEM f, &H0008, "!", 4: PUT #f, , V_0dc8!
    RT_CG_ITEM f, &H000C, "$", 4 + LEN(V_0dcc$): RT_CG_STR f, V_0dcc$
    RT_CG_ITEM f, &H0010, "$", 4 + LEN(V_0dd0$): RT_CG_STR f, V_0dd0$
    RT_CG_ITEM f, &H0014, "$", 4 + LEN(V_0dd4$): RT_CG_STR f, V_0dd4$
    RT_CG_ITEM f, &H0034, "$", 4 + LEN(V_0df4$): RT_CG_STR f, V_0df4$
    RT_CG_ITEM f, &H0038, "$", 4 + LEN(V_0df8$): RT_CG_STR f, V_0df8$
