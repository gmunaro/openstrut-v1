    RT_CG_ITEM f, &H006C, "!", 4: PUT #f, , V_0e2c!
    RT_CG_ITEM f, &H0070, "!", 4: PUT #f, , V_0e30!
    RT_CG_ITEM f, &H0074, "%", 2: PUT #f, , V_0e34%
