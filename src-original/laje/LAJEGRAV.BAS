FUNCTION RT_ONKEY_FICA% (i AS INTEGER)
    SELECT CASE i
        CASE 1   ' L_10475: BEEP; GOSUB L_101cf; RETURN
            BEEP
            RT_ONKEY_FICA% = -1
        CASE 2   ' L_104a0: sai da SUB (RT_SCREEN 0; RT_VIEWPRINT 1, 25; COLOR 7, 0, 0; RT_CLS 0; PRINT " Aguarde ..."; )
