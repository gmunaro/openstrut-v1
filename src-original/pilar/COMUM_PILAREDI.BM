SUB RT_COMMON_LE (f AS INTEGER)
    DIM ender AS LONG, tipo AS STRING * 1, nd AS INTEGER, lb(1 TO 3) AS LONG, ub(1 TO 3) AS LONG
    DIM tam AS LONG, prox AS LONG
    DO WHILE RT_CL_ITEM(f, ender, tipo, nd, lb(), ub(), tam)
        prox = SEEK(f) + tam
        SELECT CASE ender
        CASE &H0000   ' V_0dc0
            IF tipo = "!" THEN
                GET #f, , V_0dc0!
            END IF
        CASE &H0004   ' V_0dc4
            IF tipo = "!" THEN
                GET #f, , V_0dc4!
            END IF
        CASE &H0008   ' V_0dc8
            IF tipo = "!" THEN
                GET #f, , V_0dc8!
            END IF
        CASE &H000C   ' V_0dcc
            IF tipo = "$" THEN
