        FOR i3 = LBOUND(A_12ae$, 3) TO UBOUND(A_12ae$, 3)
            FOR i2 = LBOUND(A_12ae$, 2) TO UBOUND(A_12ae$, 2)
                FOR i1 = LBOUND(A_12ae$, 1) TO UBOUND(A_12ae$, 1)
                    RT_CG_STR f, A_12ae$(i1, i2, i3)
                NEXT
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_12dc!, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H051C, "!", 3, LBOUND(A_12dc!, 1), UBOUND(A_12dc!, 1), LBOUND(A_12dc!, 2), UBOUND(A_12dc!, 2), LBOUND(A_12dc!, 3), UBOUND(A_12dc!, 3)
        FOR i3 = LBOUND(A_12dc!, 3) TO UBOUND(A_12dc!, 3)
            FOR i2 = LBOUND(A_12dc!, 2) TO UBOUND(A_12dc!, 2)
                FOR i1 = LBOUND(A_12dc!, 1) TO UBOUND(A_12dc!, 1)
                    PUT #f, , A_12dc!(i1, i2, i3)
                NEXT
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_130a%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H054A, "%", 2, LBOUND(A_130a%, 1), UBOUND(A_130a%, 1), LBOUND(A_130a%, 2), UBOUND(A_130a%, 2), 0, 0
        FOR i2 = LBOUND(A_130a%, 2) TO UBOUND(A_130a%, 2)
            FOR i1 = LBOUND(A_130a%, 1) TO UBOUND(A_130a%, 1)
                PUT #f, , A_130a%(i1, i2)
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_1338%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0578, "%", 3, LBOUND(A_1338%, 1), UBOUND(A_1338%, 1), LBOUND(A_1338%, 2), UBOUND(A_1338%, 2), LBOUND(A_1338%, 3), UBOUND(A_1338%, 3)
        FOR i3 = LBOUND(A_1338%, 3) TO UBOUND(A_1338%, 3)
            FOR i2 = LBOUND(A_1338%, 2) TO UBOUND(A_1338%, 2)
                FOR i1 = LBOUND(A_1338%, 1) TO UBOUND(A_1338%, 1)
                    PUT #f, , A_1338%(i1, i2, i3)
                NEXT
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_1366%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H05A6, "%", 3, LBOUND(A_1366%, 1), UBOUND(A_1366%, 1), LBOUND(A_1366%, 2), UBOUND(A_1366%, 2), LBOUND(A_1366%, 3), UBOUND(A_1366%, 3)
        FOR i3 = LBOUND(A_1366%, 3) TO UBOUND(A_1366%, 3)
            FOR i2 = LBOUND(A_1366%, 2) TO UBOUND(A_1366%, 2)
                FOR i1 = LBOUND(A_1366%, 1) TO UBOUND(A_1366%, 1)
                    PUT #f, , A_1366%(i1, i2, i3)
                NEXT
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_1394%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H05D4, "%", 1, LBOUND(A_1394%, 1), UBOUND(A_1394%, 1), 0, 0, 0, 0
        FOR i1 = LBOUND(A_1394%, 1) TO UBOUND(A_1394%, 1)
            PUT #f, , A_1394%(i1)
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_13c2%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0602, "%", 1, LBOUND(A_13c2%, 1), UBOUND(A_13c2%, 1), 0, 0, 0, 0
        FOR i1 = LBOUND(A_13c2%, 1) TO UBOUND(A_13c2%, 1)
            PUT #f, , A_13c2%(i1)
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_13f0%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0630, "%", 2, LBOUND(A_13f0%, 1), UBOUND(A_13f0%, 1), LBOUND(A_13f0%, 2), UBOUND(A_13f0%, 2), 0, 0
        FOR i2 = LBOUND(A_13f0%, 2) TO UBOUND(A_13f0%, 2)
            FOR i1 = LBOUND(A_13f0%, 1) TO UBOUND(A_13f0%, 1)
                PUT #f, , A_13f0%(i1, i2)
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    IF LBOUND(A_141e%, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H065E, "%", 3, LBOUND(A_141e%, 1), UBOUND(A_141e%, 1), LBOUND(A_141e%, 2), UBOUND(A_141e%, 2), LBOUND(A_141e%, 3), UBOUND(A_141e%, 3)
        FOR i3 = LBOUND(A_141e%, 3) TO UBOUND(A_141e%, 3)
            FOR i2 = LBOUND(A_141e%, 2) TO UBOUND(A_141e%, 2)
                FOR i1 = LBOUND(A_141e%, 1) TO UBOUND(A_141e%, 1)
                    PUT #f, , A_141e%(i1, i2, i3)
                NEXT
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
    RT_CG_ITEM f, &H068C, "!", 4: PUT #f, , V_144c!
    IF LBOUND(A_1450!, 1) <> -32768 THEN
        RT_CG_MATRIZ f, &H0690, "!", 2, LBOUND(A_1450!, 1), UBOUND(A_1450!, 1), LBOUND(A_1450!, 2), UBOUND(A_1450!, 2), 0, 0
        FOR i2 = LBOUND(A_1450!, 2) TO UBOUND(A_1450!, 2)
            FOR i1 = LBOUND(A_1450!, 1) TO UBOUND(A_1450!, 1)
                PUT #f, , A_1450!(i1, i2)
            NEXT
        NEXT
        RT_CG_FECHA f
    END IF
END SUB

