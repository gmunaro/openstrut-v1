' ON KEY dentro de SUB: -1 = o tratador i volta com RETURN simples e roda aqui; 0 = sai da SUB.
FUNCTION RT_ONKEY_FICA% (i AS INTEGER)
    SELECT CASE i
        CASE 1   ' L_10a73: BEEP; GOSUB L_107ce; RETURN
            BEEP
            RT_ONKEY_FICA% = -1
        CASE 2   ' L_10a9e: sai da SUB (RT_SCREEN 0; RT_VIEWPRINT 1, 25; COLOR 7, 0, 0; RT_CLS 0; PRINT " Aguarde ..."; )
        CASE 3   ' L_10bb8: sai da SUB (BEEP; GOSUB L_107ce; RETURN L_10be6)
        CASE 4   ' L_14390: sai da SUB (V_0e14$ = "R"; RETURN)
    END SELECT
END FUNCTION

SUB RT_REARMA_ERRO
    RT_ERRO_MIXT = 0
