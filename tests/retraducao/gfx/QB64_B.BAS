' Sonda grafica no QB64 com RT45GFX (gerada por gera_sonda.py; nao editar)
' Saida: <pasta de SISTRUT_SAIDA ou corrente>G<n>.RAW (indices de cor) e GFXB.TXT
'$INCLUDE: '../../../src-original/comum/RT45.BI'
'$INCLUDE: '../../../src-original/comum/RT45GFX.BI'
DIM SHARED buf(8000) AS INTEGER
DIM SHARED k AS LONG, op AS INTEGER, v AS INTEGER, m AS INTEGER, n AS INTEGER
DIM SHARED x1 AS SINGLE, y1 AS SINGLE, x2 AS SINGLE, y2 AS SINGLE, c AS INTEGER, b AS INTEGER, s AS INTEGER
DIM SHARED r AS SINGLE, a1 AS SINGLE, a2 AS SINGLE, asp AS SINGLE, px AS SINGLE, py AS SINGLE
DIM SHARED saida AS STRING, nativo AS INTEGER
saida = ENVIRON$("SISTRUT_SAIDA")
nativo = (ENVIRON$("GFX_NATIVO") <> "")
OPEN saida + "GFXB.TXT" FOR OUTPUT AS #9
ON ERROR GOTO erro
DO
  READ op: k = k + 1
  SELECT CASE op
  CASE 0: EXIT DO
  CASE 1: READ m: RT_SCREEN m
  CASE 2: READ v, x1, y1, x2, y2, c, b: RT_VIEW v, CINT(x1), CINT(y1), CINT(x2), CINT(y2), c, b
  CASE 3: READ v, x1, y1, x2, y2: RT_WINDOW v, x1, y1, x2, y2
  CASE 4: READ v, x1, y1, x2, y2, c, s
    IF nativo THEN LINHA_NATIVA ELSE RT_LINE x1, y1, x2, y2, v, c, s
  CASE 5: READ v, x1, y1, c
    IF nativo THEN PONTO_NATIVO ELSE RT_PSET x1, y1, v, c
  CASE 6: READ v, x1, y1, r, c, a1, a2, asp
    IF nativo THEN CIRCULO_NATIVO ELSE RT_CIRCLE x1, y1, r, v, c, a1, a2, asp
  CASE 7: READ n: DESPEJA n
  CASE 8: RT_VIEW 0, 0, 0, 0, 0, -1, -1: RT_WINDOW 0, 0, 0, 0, 0: CLS
  CASE 9: READ x1, y1, x2, y2, px, py
    IF nativo THEN
      GET (x1, y1)-(x2, y2), buf(): PUT (px, py), buf(), PSET
    ELSE
      RT_GCAIXA x1, y1, x2, y2, 0: GET (RG_GX1, RG_GY1)-(RG_GX2, RG_GY2), buf(): RT_GFIM
      RT_GPONTO px, py, 0: PUT (RG_GX1, RG_GY1), buf(), PSET: RT_GFIM
    END IF
  CASE 10: READ x1, n: PRINT #9, k; RT_PMAP!(x1, n)
  CASE 11: READ v, x1, y1, x2, y2, px, py
    IF nativo THEN
      GETPUT_NATIVO
    ELSE
      RT_GCAIXA x1, y1, x2, y2, v AND 6: GET (RG_GX1, RG_GY1)-(RG_GX2, RG_GY2), buf(): RT_GFIM
      RT_GPONTO px, py, (v AND 8) \ 4: PUT (RG_GX1, RG_GY1), buf(), PSET: RT_GFIM
    END IF
  END SELECT
LOOP
CLOSE #9
SYSTEM
erro:
PRINT #9, "ERRO"; ERR; "op"; k
RESUME NEXT
