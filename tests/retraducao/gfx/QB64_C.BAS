' Indices de cor da pagina de desenho, linha a linha (sem VIEW/WINDOW).
SUB DESPEJA (n AS INTEGER)
    DIM mm AS _MEM, t AS STRING, f AS INTEGER
    mm = _MEMIMAGE(_DEST)
    t = SPACE$(_WIDTH(_DEST) * _HEIGHT(_DEST))
    _MEMGET mm, mm.OFFSET, t
    _MEMFREE mm
    f = FREEFILE: OPEN saida + "G" + LTRIM$(STR$(n)) + ".RAW" FOR OUTPUT AS #f: CLOSE #f
    OPEN saida + "G" + LTRIM$(STR$(n)) + ".RAW" FOR BINARY AS #f: PUT #f, , t: CLOSE #f
END SUB

SUB LINHA_NATIVA
SELECT CASE v
CASE 8: LINE -(x2, y2), c
CASE 9: LINE (x1, y1)-(x2, y2), c
CASE 12: LINE -STEP(x2, y2), c
CASE 15: LINE STEP(x1, y1)-STEP(x2, y2), c
CASE 25: LINE (x1, y1)-(x2, y2), c, B
CASE 41: LINE (x1, y1)-(x2, y2), c, BF
CASE 73: LINE (x1, y1)-(x2, y2), c, , s
CASE 89: LINE (x1, y1)-(x2, y2), c, B, s
END SELECT
END SUB
SUB PONTO_NATIVO
SELECT CASE v
CASE 1: PSET (x1, y1)
CASE 9: PSET (x1, y1), c
CASE 10: PSET STEP(x1, y1), c
END SELECT
END SUB
