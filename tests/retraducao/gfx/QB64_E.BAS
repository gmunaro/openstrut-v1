' Indices de cor da pagina de desenho, linha a linha (sem VIEW/WINDOW).
SUB DESPEJA (n AS INTEGER)
    DIM mm AS _MEM, t AS STRING, f AS INTEGER
    mm = _MEMIMAGE(_DEST)
    t = SPACE$(_WIDTH(_DEST) * _HEIGHT(_DEST))
    _MEMGET mm, mm.OFFSET, t
    _MEMFREE mm
    f = FREEFILE: OPEN saida + "G" + LTRIM$(STR$(n)) + ".RAW" FOR OUTPUT AS #f: CLOSE #f
    OPEN saida + "G" + LTRIM$(STR$(n)) + ".RAW" FOR BINARY AS #f: PUT #f, , t: CLOSE #f
END SUB

SUB LINHA_NATIVA
SELECT CASE v
CASE 8: LINE -(x2, y2), c
CASE 9: LINE (x1, y1)-(x2, y2), c
CASE 12: LINE -STEP(x2, y2), c
CASE 41: LINE (x1, y1)-(x2, y2), c, BF
CASE 73: LINE (x1, y1)-(x2, y2), c, , s
CASE 89: LINE (x1, y1)-(x2, y2), c, B, s
END SELECT
END SUB
SUB PONTO_NATIVO
SELECT CASE v
CASE 9: PSET (x1, y1), c
CASE 10: PSET STEP(x1, y1), c
CASE 129: PRESET (x1, y1)
CASE 137: PRESET (x1, y1), c
END SELECT
END SUB
SUB GETPUT_NATIVO
SELECT CASE v
CASE 0: GET (x1, y1)-(x2, y2), buf(): PUT (px, py), buf(), PSET
CASE 2: GET STEP(x1, y1)-(x2, y2), buf(): PUT (px, py), buf(), PSET
CASE 4: GET (x1, y1)-STEP(x2, y2), buf(): PUT (px, py), buf(), PSET
CASE 6: GET STEP(x1, y1)-STEP(x2, y2), buf(): PUT (px, py), buf(), PSET
CASE 8: GET (x1, y1)-(x2, y2), buf(): PUT STEP(px, py), buf(), PSET
CASE 12: GET (x1, y1)-STEP(x2, y2), buf(): PUT STEP(px, py), buf(), PSET
END SELECT
END SUB
SUB CIRCULO_NATIVO
SELECT CASE v
CASE 9: CIRCLE (x1, y1), r, c
CASE 10: CIRCLE STEP(x1, y1), r, c
CASE 777: CIRCLE (x1, y1), r, c, a1, a2
CASE 1033: CIRCLE (x1, y1), r, c, , , asp
CASE 1801: CIRCLE (x1, y1), r, c, a1, a2, asp
END SELECT
END SUB

